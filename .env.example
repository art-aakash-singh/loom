LOOM_DATABASE_URL=postgresql+asyncpg://loom:loom@localhost:5432/loom
LOOM_REDIS_URL=redis://localhost:6379/0

# LLM (fake | anthropic). anthropic requires LOOM_ANTHROPIC_API_KEY or startup fails.
LOOM_LLM_PROVIDER=fake
LOOM_ANTHROPIC_API_KEY=
# Fake provider only: rate_limited | overloaded | auth_failed | invalid_request | unexpected | refusal
LOOM_FAKE_FAIL_WITH=
LOOM_LLM_MODEL=claude-sonnet-5-5
LOOM_LLM_MAX_TOKENS=1024
